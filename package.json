{
  "name": "markos-backend",
  "version": "0.0.1",
  "description": "Markos NestJS backend with PostgreSQL",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run validate && npx nest build && node scripts/prune-dev-on-host.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --max-old-space-size=384 dist/main",
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 ts-node scripts/dev.ts",
    "start:dev": "NODE_OPTIONS=--max-old-space-size=4096 ts-node scripts/dev.ts",
    "start:debug": "NODE_OPTIONS=--max-old-space-size=4096 nest start --debug --watch",
    "start:prod": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --max-old-space-size=384 dist/main",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 npx eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=4096 npx eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings 0",
    "audit:check": "npm audit --audit-level=low",
    "deps:check": "node scripts/check-deps.mjs",
    "validate": "npm run lint && npm run audit:check && npm run deps:check",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:local": "ts-node scripts/start-local-db.ts",
    "db:sync": "ts-node scripts/sync-db.ts",
    "seed:user": "ts-node -r tsconfig-paths/register scripts/seed-user.ts",
    "seed:company-platform-form": "ts-node -r tsconfig-paths/register scripts/seed-company-platform-form.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "imapflow": "^1.7.0",
    "jose": "^6.2.10",
    "nodemailer": "^10.1.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.34.1",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "qs": "6.16.0",
    "js-yaml": "4.3.2",
    "multer": "2.4.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "handlebars": "4.7.10",
    "ip-address": "10.7.4",
    "proxy-addr": "2.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
