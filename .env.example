PORT=3008
FRONTEND_URL=http://localhost:3007
DATABASE_URL=postgresql://markos:markos@localhost:5435/markos
NODE_ENV=development
# Set SKIP_DB=true to run API without Postgres (health returns degraded)
SKIP_DB=false
# Postgres: `npm run db:up` (Docker) or `npm run db:local` (embedded, no Docker)

# Optional admin user for the platform registry (role: admin)
SEED_USER_EMAIL=admin@markos.dev
SEED_USER_PASSWORD=Markos123!

# SMTP (required for sign-up OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Aliases also supported: SMTP_PASSWORD, EMAIL_FROM / SMTP_FROM
SMTP_FROM=noreply@markos.dev
SMTP_SECURE=false

# Public backend URL (legacy fallback for OAuth callback base URL)
BACKEND_URL=http://localhost:3008
# OpenWA webhooks must reach this host. When unset, uses public BACKEND_URL or TRACKING_BASE_URL,
# otherwise falls back to BACKEND_URL (often localhost). Use ngrok + /api when proxied via Next.js:
# OPENWA_WEBHOOK_BASE_URL=https://your-tunnel.example.com/api
# Same-machine local dev: on the OpenWA server set SSRF_ALLOWED_HOSTS=localhost,127.0.0.1
# On the OpenWA gateway host (not this API), keep PUPPETEER_HEADLESS=true so Chromium stays headless.
# A visible web.whatsapp.com tab on your desktop means OpenWA is running with headless disabled or
# is (re)starting a session — correlate with OpenWA logs for POST /sessions/:id/start and GET .../media.
# Website Google OAuth callback base URL — use localhost for local dev, not the email tracking tunnel
WEBSITE_OAUTH_CALLBACK_BASE_URL=http://localhost:3008
# Tracking pixel and click URLs embedded in campaign emails — must be reachable by
# external mail servers (Gmail, Outlook, etc.). When the API is behind the Next.js
# /api proxy, use the frontend origin + /api, e.g.:
# TRACKING_BASE_URL=https://devmarketniti.evervent.live/api
# When unset, defaults to {FRONTEND_URL}/api. Use ngrok URL + /api for local inbox testing.
# TRACKING_BASE_URL=https://devmarketniti.evervent.live/api
# Allow campaign sends when TRACKING_BASE_URL is localhost (opens/clicks still won't work externally)
ALLOW_LOCAL_TRACKING=false
# HMAC secret for signed click tracking URLs (defaults to JWT_SECRET)
TRACKING_HMAC_SECRET=
# IMAP reply polling cron (default: every 2 minutes). Example: */5 * * * * for every 5 minutes.
REPLY_POLL_INTERVAL_CRON=*/2 * * * *
# IMAP bounce polling cron (default: every 2 minutes).
BOUNCE_POLL_INTERVAL_CRON=*/2 * * * *

# Encrypt stored mailbox credentials (API keys, app passwords, OAuth tokens, SMTP passwords)
CREDENTIALS_ENCRYPTION_KEY=

# Gmail / Google OAuth for mailboxes and calendar only.
# Website Google connect uses each organization's OAuth app saved in the database.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OAuth (optional — enables “Connect with Microsoft” for mailboxes)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
